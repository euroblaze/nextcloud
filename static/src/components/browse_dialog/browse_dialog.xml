<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="nextcloud.BrowseDialog">
        <Dialog title="'Browse Nextcloud'" size="'lg'" footer="false">
            <div class="o_nc_browse">
                <div class="o_nc_browse_header d-flex justify-content-between align-items-center mb-2">
                    <nav aria-label="breadcrumb" class="flex-grow-1">
                        <ol class="breadcrumb mb-0">
                            <t t-foreach="state.breadcrumbs" t-as="crumb" t-key="crumb.id">
                                <li class="breadcrumb-item">
                                    <a href="#" t-on-click.prevent="() =&gt; this.openFolder(crumb.id)">
                                        <t t-esc="crumb.label"/>
                                    </a>
                                </li>
                            </t>
                        </ol>
                    </nav>
                    <button class="btn btn-sm btn-secondary ms-2"
                            t-on-click="onSync" t-att-disabled="state.loading">
                        <i class="fa fa-refresh me-1"/> Sync
                    </button>
                </div>

                <div t-if="state.loading" class="text-center py-4">
                    <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
                </div>

                <table t-else="" class="table table-sm table-hover o_nc_browse_table">
                    <thead>
                        <tr>
                            <th style="width: 60%">Name</th>
                            <th>Type</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="children()" t-as="row" t-key="row.id"
                            t-att-class="row.folder ? 'o_nc_folder' : 'o_nc_file'">
                            <td>
                                <t t-if="row.folder">
                                    <a href="#" t-on-click.prevent="() =&gt; this.openFolder(row.id)">
                                        <i class="fa fa-folder text-warning me-2"/>
                                        <t t-esc="row.folder_name || row.name"/>
                                    </a>
                                </t>
                                <t t-else="">
                                    <i class="fa fa-file-o text-muted me-2"/>
                                    <t t-esc="row.folder_name || row.name"/>
                                </t>
                            </td>
                            <td>
                                <span t-if="row.folder" class="badge bg-secondary">folder</span>
                                <span t-else="" class="text-muted small">
                                    <t t-esc="row.file_type or '—'"/>
                                </span>
                            </td>
                            <td class="text-end">
                                <button t-if="!row.folder"
                                        class="btn btn-sm btn-primary"
                                        t-att-disabled="state.picking"
                                        t-on-click="() =&gt; this.onPickFile(row)">
                                    Attach
                                </button>
                            </td>
                        </tr>
                        <tr t-if="!children().length and !state.loading">
                            <td colspan="3" class="text-muted text-center py-3">
                                Empty folder.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </Dialog>
    </t>

</templates>
