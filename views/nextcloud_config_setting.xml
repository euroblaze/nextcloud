<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_nextcloud" model="ir.ui.view">
        <field name="name">res.config.settings.view.nextcloud</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Nextcloud" string="Nextcloud" name="nextcloud"
                     logo="/nextcloud/static/description/icon.png">
                    <block title="Connection" name="nextcloud_connection_setting_container">
                        <setting id="nextcloud_url_setting" string="Nextcloud URL"
                                 help="Base URL of your Nextcloud server">
                            <field name="nextcloud_url" placeholder="https://nc.example.com"/>
                        </setting>
                        <setting id="nextcloud_username_setting" string="Username">
                            <field name="nextcloud_username"/>
                        </setting>
                        <setting id="nextcloud_password_setting" string="App Password"
                                 help="Use an app-password (Nextcloud Settings → Security → 'Devices &amp; sessions').">
                            <field name="nextcloud_password" password="True"/>
                        </setting>
                        <setting id="nextcloud_default_folder_setting" string="Default Folder">
                            <field name="nextcloud_folder_id"
                                   options="{'no_create': True, 'no_quick_create': True}"
                                   domain="[('folder', '=', True)]"/>
                        </setting>
                        <setting id="nextcloud_test_connection_setting" string="Test Connection">
                            <button type="object" name="nextcloud_test_connection"
                                    string="Test Connection &amp; Sync"
                                    class="btn-primary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
