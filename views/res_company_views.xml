<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_company_form_inherit_nextcloud" model="ir.ui.view">
        <field name="name">res.company.form.inherit.nextcloud</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr='//page[@name="general_info"]' position="after">
                <page string="Nextcloud" name="nextcloud_settings" groups="base.group_system">
                    <group>
                        <group string="Connection">
                            <field name="nextcloud_url" placeholder="https://nc.example.com"/>
                            <field name="nextcloud_username"/>
                            <field name="nextcloud_password" password="True"
                                   help="Use a Nextcloud app-password (Settings → Security)."/>
                            <field name="nextcloud_folder_id"
                                   domain="[('folder', '=', True)]"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="nextcloud_last_sync" readonly="1"/>
                        </group>
                        <group string="Actions">
                            <button name="nextcloud_test_connection" type="object"
                                    string="Test Connection &amp; Sync"
                                    class="btn-primary"/>
                            <button name="sync_nextcloud_folder" type="object"
                                    string="Re-sync Folders"
                                    class="btn-secondary"/>
                        </group>
                    </group>
                    <group string="Folder Mapping (per model)">
                        <field name="nextcloud_folder_mapping_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="model_name"/>
                                <field name="nextcloud_folder_id"
                                       domain="[('folder', '=', True)]"
                                       options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                                <field name="domain"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
